# Local value; set production on Render.
NODE_ENV=development
# Optional locally; Render injects the service port.
PORT=5000
# Required by the API and admin bootstrap script. Replace with your private database URI.
MONGO_URI=replace-with-your-MongoDB-connection-string
# Required by the API. Generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
# Required in production; use the exact frontend origin without a trailing slash.
CORS_ORIGINS=http://localhost:5173

# Optional, one-time admin bootstrap only. Set privately; remove the password after use.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
